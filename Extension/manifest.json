{
  "manifest_version": 3,
  "name": "LumaShade — Readable Dark Mode",
  "short_name": "LumaShade",
  "version": "1.1.0",
  "description": "A calm dark mode for bright websites, with readable text and untouched photos and video.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "css": ["content.css"], "js": ["colors.js", "content.js"], "run_at": "document_idle", "all_frames": false }]
}
